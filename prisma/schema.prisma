// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// ============================================================================
// User & Authentication (Demo-only - not production-ready)
// ============================================================================

enum UserRole {
  CUSTOMER
  ADMIN
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  firstName     String
  lastName      String
  role          UserRole @default(CUSTOMER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  addresses     Address[]
  orders        Order[]

  @@index([email])
}

// ============================================================================
// Addresses
// ============================================================================

enum AddressType {
  SHIPPING
  BILLING
}

model Address {
  id        String     @id @default(cuid())
  type      AddressType
  firstName String
  lastName  String
  line1     String
  line2     String?
  city      String
  state     String
  postalCode String
  country   String
  phone     String?
  isDefault Boolean    @default(false)
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================================
// Brand
// ============================================================================

model Brand {
  id          String   @id
  name        String
  slug        String   @unique
  description String
  products    Product[]

  @@index([slug])
}

// ============================================================================
// Category
// ============================================================================

model Category {
  id          String     @id
  name        String
  slug        String     @unique
  description String
  image       Json?
  parentId    String?
  order       Int        @default(0)
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]  @relation("ProductCategories")

  @@index([slug])
  @@index([parentId])
}

// ============================================================================
// Product
// ============================================================================

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id              String         @id
  name            String
  slug            String         @unique
  description     String
  body            String?        @db.Text
  images          Json
  status          ProductStatus @default(ACTIVE)
  brandId         String
  tags            String[]
  rating          Float          @default(0)
  reviewCount     Int            @default(0)
  featured        Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  brand           Brand          @relation(fields: [brandId], references: [id])
  categories      Category[]     @relation("ProductCategories")
  variants        ProductVariant[]
  orderItems      OrderItem[]

  @@index([slug])
  @@index([status])
  @@index([brandId])
  @@index([featured])
}

// ============================================================================
// Product Variant
// ============================================================================

model ProductVariant {
  id            String   @id
  productId     String
  sku           String   @unique
  name          String
  price         Int      // cents
  compareAtPrice Int?    // cents
  currency      String   @default("USD")
  quantity      Int      @default(0)
  safetyStock   Int      @default(5)
  reorderQuantity Int    @default(25)
  supplierCost  Int?     // cents/paise
  supplierName  String?  @default("PayPilot Primary Supplier")
  trackInventory Boolean @default(true)
  allowBackorder Boolean @default(false)
  options       Json
  images        Json
  weight        Float?
  length        Float?
  width         Float?
  height        Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]
  stockAdjustments StockAdjustmentLog[]

  @@index([productId])
  @@index([sku])
}

// ============================================================================
// CMS Pages
// ============================================================================

model CmsPage {
  id          String   @id
  title       String
  slug        String   @unique
  excerpt     String?
  body        String   @db.Text
  publishedAt DateTime
  updatedAt   DateTime?

  @@index([slug])
}

// ============================================================================
// Blog Posts
// ============================================================================

model BlogPost {
  id          String   @id
  title       String
  slug        String   @unique
  excerpt     String
  body        String   @db.Text
  author      String
  tags        String[]
  coverImage  Json?
  publishedAt DateTime
  updatedAt   DateTime?

  @@index([slug])
  @@index([publishedAt])
}

// ============================================================================
// Orders
// ============================================================================

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  PAYPAL
  BANK_TRANSFER
  WALLET
  OTHER
}

model Order {
  id               String        @id
  orderNumber      String        @unique
  userId           String?
  status           OrderStatus   @default(PENDING)
  paymentStatus    PaymentStatus @default(PENDING)
  paymentMethod    PaymentMethod?
  paymentReference String?       @unique // PayPal capture id or transaction id
  paypalOrderId    String?       @unique // PayPal order id
  subtotal         Int           // cents
  tax              Int           // cents
  shipping         Int           // cents
  total            Int           // cents
  currency         String        @default("USD")
  customerEmail    String
  customerName     String
  shippingAddress  Json
  billingAddress   Json?
  carrier          String?       // e.g. "Blue Dart", "Delhivery"
  trackingNumber   String?       // AWB tracking number
  completedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user             User?         @relation(fields: [userId], references: [id])
  items            OrderItem[]
  invoice          Invoice?
  shipment         Shipment?

  @@index([orderNumber])
  @@index([userId])
  @@index([customerEmail])
  @@index([paymentReference])
  @@index([paypalOrderId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id
  orderId     String
  productId   String
  variantId   String
  name        String
  variantName String
  sku         String
  image       Json
  price       Int      // cents
  quantity    Int
  total       Int      // cents
  createdAt   DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

// ============================================================================
// AI Cart Proposals (Task 19)
// ============================================================================

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum ProposalOutcome {
  PENDING
  APPLIED
  REJECTED_BY_USER
  VALIDATION_FAILED
  EXPIRED
}

model CartProposal {
  id            String          @id @default(cuid())
  status        ProposalStatus  @default(PENDING)
  outcome       ProposalOutcome @default(PENDING)
  action        String          @default("add_to_cart")
  currency      String          @default("USD")
  items         Json            // CartProposalLine[]
  rejected      Json?           // CartProposalRejection[]
  summary       Json            // CartProposalSummary
  note          String?
  decidedAt     DateTime?
  reason        String?
  expiresAt     DateTime
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([id])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
}

// ============================================================================
// PayPal Checkout Records (Task 20)
// ============================================================================

enum PaypalCheckoutStatus {
  PENDING
  COMPLETED
  FAILED
}

model PaypalCheckout {
  id             String               @id @default(cuid())
  reference      String               @unique
  status         PaypalCheckoutStatus @default(PENDING)
  currency       String               @default("USD")
  amounts        Json                 // PaypalCheckoutAmounts
  lines          Json                 // PaypalCheckoutLine[]
  customerEmail  String?
  customerName   String?
  userId         String?
  shippingAddress Json?
  paypalOrderId  String?              @unique
  captureId      String?              @unique
  failureReason  String?
  createdAt      DateTime             @default(now())
  expiresAt      DateTime
  capturedAt     DateTime?

  @@index([reference])
  @@index([paypalOrderId])
  @@index([captureId])
  @@index([status])
  @@index([expiresAt])
}

// ============================================================================
// Coupons & Vouchers
// ============================================================================

model Coupon {
  id                 String    @id @default(cuid())
  code               String    @unique
  title              String
  description        String
  discountType       String    // "fixed" or "percentage"
  discountValue      Int       // cents/paise (50000 = ₹500, or 10 = 10%)
  minOrderValue      Int?      // cents/paise (99900 = ₹999)
  maxDiscountAmount  Int?      // cents/paise (max cap for percentage discounts)
  firstPurchaseOnly  Boolean   @default(false)
  targetScenario     String    @default("GENERAL") // "GENERAL" | "FIRST_PURCHASE" | "FESTIVAL_SPECIAL" | "CATEGORY_SPECIFIC" | "BRAND_SPECIFIC"
  targetCategorySlug String?
  targetBrandSlug    String?
  isActive           Boolean   @default(true)
  usageLimit         Int?
  usedCount          Int       @default(0)
  startDate          DateTime  @default(now())
  expiresAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([code])
  @@index([isActive])
  @@index([targetScenario])
}

// ============================================================================
// Flash Sales & Promotional Banners
// ============================================================================

model FlashSale {
  id                 String    @id @default(cuid())
  title              String
  slug               String    @unique
  description        String
  discountType       String    @default("percentage") // "percentage" | "fixed"
  discountValue      Int       // e.g. 25 = 25% or 50000 = ₹500
  appliesTo          String    @default("STOREWIDE") // "STOREWIDE" | "CATEGORY" | "BRAND"
  targetCategorySlug String?
  targetBrandSlug    String?
  bannerBadge        String    @default("FLASH SALE")
  bannerHeadline     String
  accentColor        String    @default("#FF3333")
  startsAt           DateTime
  endsAt             DateTime
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([slug])
  @@index([isActive])
  @@index([startsAt])
  @@index([endsAt])
}

model PromotionalBanner {
  id              String    @id @default(cuid())
  title           String
  message         String
  promoCode       String?
  linkText        String    @default("Shop Now")
  linkUrl         String    @default("/shop")
  badgeText       String    @default("FESTIVE OFFER")
  backgroundColor String    @default("#000000")
  textColor       String    @default("#FFFFFF")
  isActive        Boolean   @default(true)
  priority        Int       @default(0)
  startsAt        DateTime  @default(now())
  endsAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isActive])
  @@index([priority])
}

// ============================================================================
// Billing & Tax Invoices
// ============================================================================

enum InvoiceStatus {
  ISSUED
  PAID
  VOID
  REFUNDED
}

model Invoice {
  id               String        @id @default(cuid())
  invoiceNumber    String        @unique // e.g. INV-2026-0001
  orderId          String        @unique
  customerName     String
  customerEmail    String
  customerGstin    String?
  storeGstin       String        @default("29AABCU9603R1Z7")
  supplyState      String        @default("Karnataka")
  placeOfSupply    String        // e.g. "Maharashtra", "Tamil Nadu"
  isInterState     Boolean       @default(false)
  hsnSummary       Json          // Array of { hsnCode, taxableAmount, igstRate, igstAmount, cgstRate, cgstAmount, sgstRate, sgstAmount }
  subtotal         Int           // paise
  cgstTotal        Int           @default(0) // paise
  sgstTotal        Int           @default(0) // paise
  igstTotal        Int           @default(0) // paise
  discountTotal    Int           @default(0) // paise
  couponCode       String?
  total            Int           // paise
  currency         String        @default("INR")
  status           InvoiceStatus @default(ISSUED)
  pdfUrl           String?
  digitalSignature String        @default("Digitally Signed by PayPilot Technologies India Pvt Ltd")
  issuedAt         DateTime      @default(now())
  dueDate          DateTime?
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([invoiceNumber])
  @@index([orderId])
  @@index([customerEmail])
  @@index([status])
}

// ============================================================================
// Payment Settlements & Gateway Reconciliation
// ============================================================================

enum SettlementStatus {
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  RECONCILED
}

model PaymentSettlement {
  id            String           @id @default(cuid())
  orderId       String
  orderNumber   String
  gateway       String           // "Razorpay" | "PhonePe" | "Stripe" | "UPI" | "Cashfree"
  gatewayTxnId  String           @unique // e.g. pay_N7xX12345678, T2603123456
  amount        Int              // paise
  currency      String           @default("INR")
  fee           Int              @default(0) // gateway fee in paise
  taxOnFee      Int              @default(0) // GST on gateway fee in paise
  netPayout     Int              // amount - fee - taxOnFee in paise
  status        SettlementStatus @default(CAPTURED)
  paymentMethod String           // "UPI", "CREDIT_CARD", "NET_BANKING", "WALLET"
  bankReference String?          // UTR or Bank RRN number
  settledAt     DateTime?
  failureReason String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([orderId])
  @@index([gatewayTxnId])
  @@index([status])
  @@index([gateway])
}

// ============================================================================
// Coupon Redemption & Expenditure Audit
// ============================================================================

model CouponRedemption {
  id             String   @id @default(cuid())
  couponCode     String
  orderId        String
  orderNumber    String
  customerEmail  String
  orderTotal     Int      // paise
  discountAmount Int      // paise (how much user saved)
  createdAt      DateTime @default(now())

  @@index([couponCode])
  @@index([orderId])
}

// ============================================================================
// Shipping, Logistics & Delivery Operations
// ============================================================================

enum ShipmentStatus {
  MANIFESTED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  ATTEMPTED_FAILED
  RTO
  DELAYED
}

model Shipment {
  id                    String         @id @default(cuid())
  orderId               String         @unique
  orderNumber           String
  carrier               String         // "Blue Dart", "Delhivery", "Shadowfax", "DTDC", "India Post"
  awbNumber             String         @unique // AWB Air Waybill tracking number
  status                ShipmentStatus @default(MANIFESTED)
  radarStatus           String         @default("ON_SCHEDULE") // "ON_SCHEDULE" | "DELAYED" | "ATTEMPTED" | "RTO" | "DELIVERED"
  originCity            String         @default("Bengaluru")
  destinationCity       String
  destinationPincode    String
  state                 String
  weightGrams           Int            @default(500)
  shippingCharge        Int            @default(0) // paise
  serviceType           String         @default("STANDARD") // "STANDARD" | "EXPRESS" | "SAME_DAY"
  estimatedDeliveryDate DateTime
  actualDeliveryDate    DateTime?
  delayReason           String?        // e.g. "Severe Rain / Highway Transit Delay"
  lastCheckpoint        String?        // e.g. "Bengaluru Central Sort Facility"
  checkpoints           Json           // Array of { status, location, timestamp, remarks }
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  order                 Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([orderNumber])
  @@index([awbNumber])
  @@index([carrier])
  @@index([status])
  @@index([radarStatus])
  @@index([destinationPincode])
}

model DeliveryZone {
  id                String   @id @default(cuid())
  pincode           String   @unique
  areaName          String
  city              String
  state             String
  zoneType          String   @default("METRO") // "METRO", "TIER_1", "TIER_2", "REMOTE"
  isServiceable     Boolean  @default(true)
  codAvailable      Boolean  @default(true)
  expressAvailable  Boolean  @default(true)
  standardDays      Int      @default(3)
  expressDays       Int      @default(1)
  preferredPartner  String   @default("Blue Dart")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([pincode])
  @@index([city])
  @@index([state])
  @@index([isServiceable])
}

model ShippingRule {
  id                String   @id @default(cuid())
  name              String
  code              String   @unique // "STANDARD", "EXPRESS", "SAME_DAY"
  description       String
  baseFee           Int      // paise (e.g. 9900 = ₹99)
  freeThreshold     Int?     // paise (e.g. 99900 = ₹999)
  estimatedDaysMin  Int
  estimatedDaysMax  Int
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([code])
  @@index([isActive])
}

model LogisticsPartner {
  id                  String   @id @default(cuid())
  name                String   @unique // "Blue Dart", "Delhivery", "Shadowfax", "DTDC"
  code                String   @unique
  trackingUrlTemplate String
  activeShipments     Int      @default(0)
  deliveredShipments  Int      @default(0)
  successRate         Float    @default(98.2) // percentage
  avgDeliveryDays     Float    @default(2.4)
  rating              Float    @default(4.8)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([code])
  @@index([isActive])
}

// ============================================================================
// Inventory & Stock Health Monitoring
// ============================================================================

model StockAdjustmentLog {
  id               String          @id @default(cuid())
  variantId        String
  sku              String
  productTitle     String
  variantName      String
  previousQuantity Int
  newQuantity      Int
  changeAmount     Int             // e.g. +20, -1, -5
  reason           String          // "RECEIVED_SHIPMENT" | "ORDER_FULFILLMENT" | "DAMAGE_LOSS" | "MANUAL_RECONCILIATION" | "RETURN_RESTOCK"
  notes            String?
  staffAuthor      String          @default("Balaganesh (Admin)")
  createdAt        DateTime        @default(now())

  variant          ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([sku])
  @@index([createdAt])
  @@index([reason])
}

model PurchaseOrderDraft {
  id                   String    @id @default(cuid())
  poNumber             String    @unique // e.g. "PO-2026-0101"
  supplierName         String
  status               String    @default("DRAFT") // "DRAFT" | "SUBMITTED" | "RECEIVED" | "CANCELLED"
  items                Json      // Array of { variantId, sku, name, productTitle, currentStock, suggestedQuantity, unitCost, totalCost }
  totalItems           Int
  totalCost            Int       // paise
  expectedDeliveryDate DateTime?
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([poNumber])
  @@index([status])
  @@index([createdAt])
}





