# ==============================================================================
# PayPilot / Next.js Ecommerce Starter — Environment Configuration Template
# Copy this file to `.env.local` for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Storefront & Deployment (Core)
# ------------------------------------------------------------------------------
# Application environment (development | production | test)
NODE_ENV=development

# Base URL for metadata, OpenGraph cards, sitemaps, and canonical links
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Toggle display of built-in sample customer reviews & rating marquee (true | false)
NEXT_PUBLIC_SHOW_SAMPLE_REVIEWS=true

# ------------------------------------------------------------------------------
# 2. Google Gemini AI Assistant (Optional / Server-side only)
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Model identifier (recommended: gemini-3.6-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-3.6-flash

# ------------------------------------------------------------------------------
# 3. PayPal Payments Integration (Optional / Server-side only)
# ------------------------------------------------------------------------------
# Obtain from PayPal Developer Dashboard: https://developer.paypal.com/dashboard/applications/sandbox
# Sandbox or Live Client ID (served safely to the client via /api/paypal/config)
PAYPAL_CLIENT_ID=

# PayPal Client Secret (server-side only; NEVER exposed to the browser)
PAYPAL_CLIENT_SECRET=

# PayPal API Base URL:
#   Sandbox: https://api-m.sandbox.paypal.com (default)
#   Live:    https://api-m.paypal.com
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com

# ------------------------------------------------------------------------------
# 4. Stripe Payments Integration (Optional)
# ------------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

